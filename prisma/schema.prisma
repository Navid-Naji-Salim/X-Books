generator client {
  provider = "prisma-client"
  output   = "../backend/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Item {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  sku               String?
  itemType          String   @default("goods")
  unit              String?
  imageUrl          String?
  description       String?
  salesEnabled      Boolean  @default(true)
  salesPrice        Decimal  @db.Decimal(12, 2)
  salesAccount      String   @default("Sales")
  salesTax          String?
  salesDescription  String?
  purchaseEnabled   Boolean  @default(true)
  unitCost          Decimal  @db.Decimal(12, 2)
  purchaseAccount   String   @default("Cost of Goods Sold")
  purchaseTax       String?
  purchaseDescription String?
  invoiceLines      InvoiceLine[]
  billLines         BillLine[]
  quantity          Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([companyId])
}

model Customer {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerType String  @default("business")
  firstName   String?
  lastName    String?
  displayName String
  companyName String?
  email       String?
  phone       String?
  addressLine1 String?
  addressLine2 String?
  city        String?
  state       String?
  postalCode  String?
  country     String?
  taxRate     String?
  paymentTerms String   @default("Due on Receipt")
  notes       String?
  invoices    Invoice[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

model Invoice {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceNumber   String
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceDate     DateTime
  terms           String
  dueDate         DateTime
  status          String        @default("Unpaid")
  customerNotes   String?
  subtotal        Decimal       @db.Decimal(12, 2)
  discountPercent Decimal       @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  lines           InvoiceLine[]
  payments        Payment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentDate DateTime
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model InvoiceLine {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId    String?
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemName  String
  quantity  Decimal  @db.Decimal(12, 2)
  rate      Decimal  @db.Decimal(12, 2)
  tax       String?
  taxRate   Decimal  @default(0) @db.Decimal(5, 2)
  amount    Decimal  @db.Decimal(12, 2)
}

model Vendor {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendorType  String   @default("business")
  firstName   String?
  lastName    String?
  displayName String
  companyName String?
  email       String?
  phone       String?
  addressLine1 String?
  addressLine2 String?
  city        String?
  state       String?
  postalCode  String?
  country     String?
  taxRate     String?
  paymentTerms String @default("Due on Receipt")
  legacyAddress String? @map("address")
  notes       String?
  bills       Bill[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

model Bill {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sequence        Int
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  billDate        DateTime
  terms           String
  dueDate         DateTime
  status          String        @default("Unpaid")
  notes           String?
  subtotal        Decimal       @db.Decimal(12, 2)
  discountPercent Decimal       @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  lines           BillLine[]
  payments        BillPayment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([companyId, sequence])
  @@index([companyId])
}

model BillLine {
  id        String   @id @default(cuid())
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  itemId    String?
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemName  String
  quantity  Decimal  @db.Decimal(12, 2)
  rate      Decimal  @db.Decimal(12, 2)
  tax       String?
  taxRate   Decimal  @default(0) @db.Decimal(5, 2)
  amount    Decimal  @db.Decimal(12, 2)
}

model BillPayment {
  id          String   @id @default(cuid())
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  paymentDate DateTime
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([billId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("User")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company?
}

model Company {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  items        Item[]
  customers    Customer[]
  vendors      Vendor[]
  invoices     Invoice[]
  bills        Bill[]
}
